[tools]
{{- if eq .purpose "work" }}
azure = { version = "latest", uvx_args = "--prerelease=disallow" }
azure-kubelogin = "latest"
"github:JuSuperSonic/azkv" = "latest"
{{- end }}

go = "latest"
rust = "latest"
node = "latest"
npm = "latest"
python = "latest"
uv = "latest"
opentofu = "latest"

kubectl = "1"
krew = "v0.5.0"
prek = "0.4"
watchexec = "latest"
"pypi:graphifyy" = { version = "latest", extras = ["terraform"] }
"go:golang.org/x/tools/gopls" = "latest"


"krew:ctx" = "latest"
"krew:node-shell" = "latest"
"krew:deprecations" = "latest"
"krew:df-pv" = "latest"
"krew:janitor" = "latest"
"krew:ns" = "latest"
"krew:popeye" = "latest"

# LSPs for Helix
"go:github.com/go-delve/delve/cmd/dlv" = "latest"
"go:github.com/golangci/golangci-lint/v2/cmd/golangci-lint" = "latest"
"go:github.com/nametake/golangci-lint-langserver" = "latest"
"npm:vscode-langservers-extracted" = "latest"
terraform-ls = "latest"

[plugins]
krew = "git@github.com:soupglasses/mise-krew"
