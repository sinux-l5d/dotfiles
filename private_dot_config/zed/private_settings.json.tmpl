          "enable_thinking": false
        },
        "name": "Plan",
        "tools": {
          "update_plan": true,
          "terminal": false,
          "open": true,
          "now": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "fetch": true,
          "diagnostics": true,
          "read_file": true
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "codebase-memory-mcp": {
            "tools": {
              "trace_path": true,
              "search_graph": true,
              "search_code": true,
              "query_graph": true,
              "manage_adr": true,
              "list_projects": true,
              "ingest_traces": true,
              "index_status": true,
              "index_repository": true,
              "get_graph_schema": true,
              "get_code_snippet": true,
              "get_architecture": true,
              "detect_changes": true,
              "delete_project": false
            }
          },
          "genkit": {
            "tools": {
              "start_runtime": false,
              "search_genkit_docs": true,
              "run_flow": false,
              "restart_runtime": true,
              "read_genkit_docs": true,
              "list_genkit_docs": true,
              "list_flows": true,
              "kill_runtime": false,
              "get_usage_guide": true,
              "get_trace": true
            }
