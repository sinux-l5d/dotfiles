    "tool_permissions": {
      "tools": {
        "mcp:genkit:read_genkit_docs": {
          "default": "allow"
        },
        "mcp:genkit:search_genkit_docs": {
          "default": "allow"
        },
        "mcp:mcp-server-context7:resolve-library-id": {
          "default": "allow",
        },
        "copy_path": {
          "default": "allow",
        },
        "create_directory": {
          "default": "allow",
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^go\\s+run(\\s|$)",
            },
            {
              "pattern": "^go\\s+vet(\\s|$)",
            },
            {
              "pattern": "^go\\s+build(\\s|$)",
            },
          ],
        },
        "mcp:mcp-server-context7:query-docs": {
          "default": "allow",
        },
      },
    },
    "default_profile": "plan",
    "default_model": {
