{{- $secrets := include ".secrets.yaml.age" | decrypt | fromYaml -}}
{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
{{- if eq .purpose "work" }}
    {
      "action": "provider.use",
      "resource": "github-copilot",
      "effect": "allow"
    },
{{- else if eq .purpose "personal" }}
    {
      "action": "provider.use",
      "resource": "mammouth",
      "effect": "allow",
    },
{{- end }}
  ],
  "instructions": [
    "~/.config/opencode/instructions/caveman.md",
    "~/.config/opencode/instructions/graphify.md",
    "~/.config/opencode/instructions/core.md",
  ],
  "plugins": [
    "@dietrichgebert/ponytail",
    "opencode-skill-creator",
  ],
{{- if eq .purpose "personal" }}
  "provider": {
    "mammouth": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{{ $secrets.mammouthai_api_key }}",
        "baseURL": "https://api.mammouth.ai/v1",
      },
      "models": {
                "gpt-5.6-luna": {},
                "gpt-5.6-terra": {},
                "claude-sonnet-5-5": {}
            }
    },
  },
{{- end }}
  "mcp": {
    "servers": {
{{- if eq .purpose "work" }}
      "context7": {
        "type": "local",
        "command": ["context7-proxied"],
        "environment": {
          "CONTEXT7_API_KEY": "{{ $secrets.context7_api_key }}",
        }
      },
      "azure-mcp": {
         "type": "local",
         "command": [
           "npx",
           "-y",
           "@azure/mcp@latest",
           "server",
           "start"
         ],
         "environment": {
           "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "1"
         }
       },
       "azure-devops": {
         "type": "local",
         "command": [
           "npx",
           "-y",
           "@azure-devops/mcp",
           "IDFM-PRIM",
           "--authentication",
           "azcli"
         ]
       },
{{- else if eq .purpose "personal" }}
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer {{ $secrets.context7_api_key }}"
        },
      },
{{- end }}
      "kubernetes": {
        "type": "local",
        "command": ["npx", "-y", "kubernetes-mcp-server@latest", "--config", "{env:HOME}/.config/opencode/kubernetes-mcp-server.toml"],
      },
      "opentofu": {
        "type": "remote",
        "url": "https://mcp.opentofu.org/mcp",
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
      "firefox-devtools": {
        "type": "local",
        "command": ["npx", "-y", "@mozilla/firefox-devtools-mcp@latest", "--tool-preset", "developer"],
      },
      "nushell": {
        "type": "local",
        "command": ["nu", "--mcp"],
      },
      "golang": {
        "type": "local",
        "command": ["gopls", "mcp"],
      },
{{- if eq .purpose "work" }}
      "logseq": {
        "type": "remote",
        "url": "http://172.28.48.1:12315/mcp",
        "oauth": false,
        "headers": { "Authorization": "Bearer {{ $secrets.logseq_token }}" },
      },
{{- end }}
    }
  }
}
