[user]
    name = Simon LEONARD
    email = git-1001af4@sinux.sh
    signingkey = ~/.ssh/git.pub
[core]
    # https://stackoverflow.com/a/1250133
    autocrlf = input
[pull]
    rebase = true
[init]
    defaultBranch = main
[alias]
    amend = commit --amend --no-edit
    st = status -s -b
    br = branch -a -v
    l = log --oneline
[commit]
    gpgsign = true
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[rebase]
    autoStash = true
[gpg]
    format = ssh
[diff]
    external = difft
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed-signers
[url "git@github.com:"]
	insteadOf = https://github.com/
