{{- $secrets := include ".secrets.yaml.age" | decrypt | fromYaml -}}

[user]
    name = Simon LEONARD
{{- if eq .purpose "personal" }}
    email = {{ $secrets.personal_git_email }}
{{- else if eq .purpose "work" }}
    email = {{ $secrets.work_email }}
{{- end }}

{{- if eq .purpose "personal" }}
    signingkey = ~/.ssh/git.pub
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed-signers
[commit]
    gpgsign = true
{{- end }}
[core]
    # https://stackoverflow.com/a/1250133
    autocrlf = input
[pull]
    rebase = true
[init]
    defaultBranch = main
[alias]
    amend = commit --amend --no-edit
    st = status -s -b
    br = branch -a -v
    l = log --oneline
    graph = log --all --decorate --oneline --graph
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[rebase]
    autoStash = true
[diff]
    external = difft
[url "git@github.com:"]
    insteadOf = https://github.com/
